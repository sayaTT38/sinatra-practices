<form action="/memos/<%= @memo['id'] %>" method="POST">
<input type="hidden" name="_method" value="PATCH">
<p>タイトル：<br>
<input type="text" name="title" value="<%= @memo['title'] %>"></p>
<p>内容：<br>
<textarea name="content"><%= @memo['content'] %></textarea></p>
<p><input type="submit" value="保存"></p>
</form>
